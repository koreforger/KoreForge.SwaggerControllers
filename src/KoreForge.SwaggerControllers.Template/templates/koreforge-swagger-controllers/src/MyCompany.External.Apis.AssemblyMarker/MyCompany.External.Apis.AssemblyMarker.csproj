<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>MyCompany.External.Apis.AssemblyMarker</PackageId>
    <Description>Empty marker assembly used by hosts to opt into MyCompany.External.Apis controllers via AddSwaggerControllers&lt;AssemblyMarker&gt;().</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="KoreForge.SwaggerControllers.Abstractions" />
  </ItemGroup>
</Project>
