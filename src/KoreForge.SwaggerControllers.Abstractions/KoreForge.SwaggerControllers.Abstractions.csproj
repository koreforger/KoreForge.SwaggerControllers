<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <PackageId>KoreForge.SwaggerControllers.Abstractions</PackageId>
    <Description>Runtime abstractions for KoreForge swagger-controllers libraries: Outcome&lt;T&gt;, ErrorInfo, AuthMode, AuthDelegatingHandler, IPrincipalRoleResolver, controller registration extensions.</Description>
    <PackageTags>koreforge;swagger;controllers;refit;outcome;authorization</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
